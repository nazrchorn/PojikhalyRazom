rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Дозволяємо користувачам завантажувати їхні власні фото профілю
    match /profile_photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Дозволяємо користувачам завантажувати фото для поїздок
    match /trip_photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // За замовчуванням не дозволяємо доступ
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}

