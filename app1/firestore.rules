rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Користувачі можуть читати свій власний документ і усі інші
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth.uid == userId;
    }

    // Поїздки
    match /trips/{tripId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth.uid == resource.data.driverId ||
                       request.auth.uid in resource.data.passengers;
      allow delete: if request.auth.uid == resource.data.driverId;
    }

    // Повідомлення
    match /messages/{messageId} {
      allow read: if request.auth.uid == resource.data.senderId ||
                     request.auth.uid == resource.data.receiverId;
      allow create: if request.auth.uid == request.resource.data.senderId;
      allow update: if false;
      allow delete: if request.auth.uid == resource.data.senderId;
    }

    // Відгуки
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth.uid == resource.data.reviewerId;
      allow delete: if request.auth.uid == resource.data.reviewerId;
    }

    // Забронювання
    match /booking_requests/{bookingId} {
      allow read: if request.auth.uid == resource.data.passengerId ||
                     request.auth.uid == resource.data.driverId;
      allow create: if request.auth.uid == request.resource.data.passengerId;
      allow update: if request.auth.uid == resource.data.driverId;
      allow delete: if request.auth.uid == resource.data.passengerId;
    }

    // За замовчуванням все заборонено
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

